# Server-only values. Never prefix these variables with NEXT_PUBLIC_.
# OpenAI-compatible chat completions endpoint.
AI_BASE_URL=https://api.openai.com/v1

# Provider secret. Configure it in the deployment platform, not in the image.
# Optional only for local providers that do not require authentication.
AI_API_KEY=

# Use a model supported by the configured provider.
AI_MODEL=
